# Maintainer: shogun2-sync contributors
pkgname=shogun2sync
pkgver=1.0.2
pkgrel=1
_rclonever=1.74.4
pkgdesc="Keep Shogun 2 multiplayer campaign saves in sync so a desync is a five-minute fix, not a dead campaign"
arch=('x86_64')
url="https://github.com/jalsarraf0/shogun2-sync"
license=('MIT')
depends=('ca-certificates' 'glibc' 'gtk3' 'systemd' 'webkit2gtk-4.1' 'xdg-utils')
makedepends=('go' 'npm')
source=(
  "$pkgname-$pkgver.tar.gz::https://github.com/jalsarraf0/shogun2-sync/releases/download/v$pkgver/shogun2-sync-$pkgver-src.tar.gz"
  "https://downloads.rclone.org/v$_rclonever/rclone-v$_rclonever-linux-amd64.zip"
)
sha256sums=(
  # build-release.sh replaces this template value in the PKGBUILD attached
  # to each release with that release source archive's exact checksum.
  'SKIP'
  'fe435e0c36228e7c2f116a8701f01127bb1f694005fc11d1f27186c8bca4115d'
)

build() {
  cd "$srcdir/shogun2-sync-$pkgver/app"
  npm ci --prefix frontend
  npm run build --prefix frontend
  export CGO_ENABLED=1
  # Match the production tags added by `wails build`.  Without desktop and
  # production, a direct Go build selects Wails' development runtime.
  go build -trimpath -tags 'desktop,production,webkit2_41' \
    -ldflags '-s -w' -o shogun2sync .
  packaging/collect-go-notices.sh GO-THIRD-PARTY-NOTICES.txt shogun2sync
}

package() {
  cd "$srcdir/shogun2-sync-$pkgver/app"
  install -Dm755 shogun2sync "$pkgdir/usr/bin/shogun2sync"
  install -Dm755 "$srcdir/rclone-v$_rclonever-linux-amd64/rclone" \
    "$pkgdir/usr/lib/shogun2sync/rclone"
  install -Dm644 packaging/rclone-COPYING \
    "$pkgdir/usr/share/licenses/$pkgname/rclone-COPYING"
  install -Dm644 ../LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 GO-THIRD-PARTY-NOTICES.txt \
    "$pkgdir/usr/share/licenses/$pkgname/GO-THIRD-PARTY-NOTICES.txt"
  install -Dm644 packaging/shogun2sync.desktop "$pkgdir/usr/share/applications/shogun2sync.desktop"
  install -Dm644 packaging/appicon-512.png "$pkgdir/usr/share/icons/hicolor/512x512/apps/shogun2sync.png"
}
