# Shared settings for the private Linux GUI runtime.
#
# RUNTIME_PREFIX is baked into libwebkit2gtk-4.1.so.0 at build time, so the
# generic installer cannot be relocated. Changing it here changes where
# install-linux.sh must place the bundle; the two are verified against each
# other in CI.
RUNTIME_PREFIX="/opt/shogun2sync"

# Same digest-pinned Debian 12 image the binary is built on. The bundle and the
# binary must come from one ABI baseline.
BOOKWORM_IMAGE="docker.io/library/debian@sha256:abd67ffcfa541b485a3dff59865ab629aa048a6c613e639d36e7456b0b229241"
